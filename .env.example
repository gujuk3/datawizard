# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=False

# ── Database ──────────────────────────────────────────────────────────────────
# Docker / production: set DATABASE_URL to use PostgreSQL
# Local dev: leave DATABASE_URL unset → falls back to SQLite automatically
DATABASE_URL=postgres://datawizard:datawizard@db:5432/datawizard

# Docker postgres password (used by docker-compose.yml)
POSTGRES_PASSWORD=datawizard

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
FRONTEND_URL=http://localhost:8000

# ── LLM ───────────────────────────────────────────────────────────────────────
# groq  → uses Groq cloud API (default)
# local → uses MLX-LM server at LOCAL_LLM_BASE_URL
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here

# Only needed when LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=datawizard-qwen3
